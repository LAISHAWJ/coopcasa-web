# ============================================================================
# Variables de entorno - COOPCASA Web
# Copia este archivo como ".env" y completa los valores reales antes de
# integrar el backend.
#
# OJO: el prefijo PUBLIC_ de Astro significa que el valor queda EMBEBIDO en el
# bundle que descarga el navegador. Acá no va ningún secreto: la API key del
# módulo de socios no puede vivir en este archivo, y por eso el endpoint de
# afiliación es anónimo y se protege con captcha y rate limit del lado del
# servidor.
# ============================================================================

# Endpoint que recibe el formulario "Hazte Socio".
# Es el grupo publico del modulo de socios: POST /api/public/membership-leads.
# Responde 202 cuando acepta la solicitud (tambien si ya habia una en tramite
# para ese documento: no distingue los casos a proposito, para no revelar que
# cedulas estan registradas).
# Local con dev-modules.ps1: https://localhost:7303/api/public/membership-leads
PUBLIC_API_MEMBERS_URL=https://api.coopcasa.do/api/public/membership-leads

# Site key de Cloudflare Turnstile. Es PUBLICA por diseño (el secreto vive solo
# en el backend, en Captcha:SecretKey). Sin esta variable el widget no se
# renderiza y el backend rechaza el envio, salvo que tenga el captcha
# deshabilitado, que es solo para QA local.
PUBLIC_TURNSTILE_SITE_KEY=

# URL del Portal de la Oficina Virtual (proyecto neocoop_member-portail, React).
# El botón/enlace "Iniciar Sesión" de la Landing redirige a `${PUBLIC_PORTAL_URL}/login`.
# En producción, cambiar solo este valor por la URL pública del Portal.
PUBLIC_PORTAL_URL=http://localhost:5173
