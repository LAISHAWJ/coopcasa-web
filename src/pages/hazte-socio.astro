import RequirementsSection from '@features/members/components/RequirementsSection.astro';
import MembersCta from '@features/members/components/MembersCta.astro';
import { membersSeo } from '@data/membersPage';
---

<MainLayout title={membersSeo.title} description={membersSeo.description}>
  <MembersHero />
  <StepsSection />
  <MemberBenefitsGrid />
