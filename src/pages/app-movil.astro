---
import MainLayout from '@shared/layouts/MainLayout.astro';
import AppHero from '@features/mobile-app/components/AppHero.astro';
import AppFeaturesGrid from '@features/mobile-app/components/AppFeaturesGrid.astro';
import AppBenefitsGrid from '@features/mobile-app/components/AppBenefitsGrid.astro';
import AppCta from '@features/mobile-app/components/AppCta.astro';
import AppFaqSection from '@features/mobile-app/components/AppFaqSection.astro';
import { mobileAppSeo } from '@data/mobileApp';
---

<MainLayout title={mobileAppSeo.title} description={mobileAppSeo.description}>
  <AppHero />
  <AppFeaturesGrid />
  <AppBenefitsGrid />
  <AppCta />
  <AppFaqSection />
</MainLayout>
