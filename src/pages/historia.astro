import InstitutionalNumbers from '@features/about/components/InstitutionalNumbers.astro';
import InstitutionalFicha from '@features/about/components/InstitutionalFicha.astro';
import { historySeo } from '@data/about';
---

<MainLayout title={historySeo.title} description={historySeo.description}>
  <HistoryHero />
  <FoundingSpotlight />
  <GrowthChapters />
  <InstitutionalNumbers />
  <InstitutionalFicha />
</MainLayout>
